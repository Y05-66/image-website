# ==================== Aliyun OSS ====================
OSS_ACCESS_KEY_ID=your_ram_user_access_key_id
OSS_ACCESS_KEY_SECRET=your_ram_user_access_key_secret
OSS_STS_ROLE_ARN=acs:ram::<account-id>:role/oss-image-uploader
OSS_BUCKET=image-website-dev-y
OSS_REGION=cn-beijing

# ==================== JWT ====================
# 生产环境务必替换为随机字符串（至少 32 字符），例如：openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_change_me_min_32_chars

# ==================== MySQL (docker-compose profile) ====================
MYSQL_ROOT_PASSWORD=123456